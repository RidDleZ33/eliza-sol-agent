# --- LLM (OpenAI-compatible; local Ollama default) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL_NAME=qwen2.5:3b

# --- Runtime (Phase 0E: services-only boot) ---
ELIZA_BOOT=0
# Phase 5A: entitlement tier (operator | desk | feed | free); default operator
ENTITLEMENT_TIER=operator
# Alpha calls OPENAI_BASE_URL/MODEL_NAME directly via src/llm/LlmClient.ts
# (OLLAMA_* vars are legacy aliases; OPENAI_* are primary)

# --- Solana ---
SOLANA_RPC_URL=https://YOUR-PAID-RPC-HOST
SOLANA_PUBLIC_KEY=
# House keypair: set ONE of these. If both set, they must resolve to the same pubkey.
#   SOLANA_PRIVATE_KEY — base64-encoded 64-byte secret key bytes
#   GAMMA_PRIVATE_KEY  — JSON array of bytes [0,0,...]
SOLANA_PRIVATE_KEY=
GAMMA_PRIVATE_KEY=

# --- Execution / risk ---
# DRY_RUN is an alias for DRY_RUN_MODE. Either set to true/1 enables dry-run.
# If both are set and they disagree, dry-run wins with a loud error (fail closed).
DRY_RUN=true
# DRY_RUN_MODE is an alias for DRY_RUN. Either set to true/1 enables dry-run.
# If both are set and they disagree, dry-run wins with a loud error (fail closed).
DRY_RUN_MODE=true
SLIPPAGE_BPS=50
MAX_TRADE_SIZE_SOL=0.5
# Phase 2A: risk caps and kill switch
MAX_DEPLOYED_SOL=2
MAX_DAILY_LOSS_SOL=0.5
KILL_SWITCH=false
# Jupiter swap API: api.jup.ag requires a key; lite-api.jup.ag does not.
JUPITER_API_KEY=
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=100000

# --- Telegram operator ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_TELEMETRY_CHAT_ID=

# --- Tape recorder (bun src/tape/index.ts) ---
TAPE_DB_PATH=data/tape/tape.sqlite
TAPE_JSONL=1
TAPE_POLL_MS=20000
TAPE_SOL_MARK_MS=60000

# --- War room ---
WAR_ROOM_ID=committee

# --- Ingestion sources ---
# One flag per feed. Default false except where noted.
INGEST_BIRDEYE_NEW_LISTING=true   # new token listings via Birdeye (primary launch board)
INGEST_BIRDEYE_TRENDING=true      # top trending tokens via Birdeye
INGEST_DEXSCREENER_LATEST=false   # latest token pairs via DexScreener
INGEST_DEXSCREENER_TRENDING=false # trending token pairs via DexScreener
INGEST_DEXSCREENER_TRENDING_PERIOD=1h
INGEST_DEXSCREENER_TRENDING_BULLISH=false
INGEST_DEXSCREENER_BOOSTS=false   # DexScreener token-boosts endpoint
INGEST_BIRDEYE_TOP_TRADERS=false  # per-mint top trader wallets via Birdeye
INGEST_PHANTOM=false              # Phantom explore trending board
INGEST_DEXSCREENER_PROFILES=false # DexScreener latest enhanced token profiles
INGEST_DEXSCREENER_CHAIN=solana
SOCIAL_BIRDEYE_LINKS=false        # fetch Birdeye socials for every mint (expensive)
PA_BIRDEYE_OHLCV=false            # Birdeye OHLCV candles for PA (12 CU/mint/90s)
PA_MIN_BARS=20                    # minimum bars before PA is considered live
PA_DEAD_LOOKBACK=10               # bars of flat price to declare dead

# --- Birdeye API ---
# INGEST_BIRDEYE_NEW_LISTING uses Birdeye API to detect new token listings.
# SOCIAL_BIRDEYE_LINKS uses Birdeye's token_overview endpoint for social links.
# WARNING: token_overview runs on every Alpha mint evaluation and can exhaust
# Birdeye API quota quickly. Default is false. Enable only with generous quota.
BIRDEYE_API_KEY=
# Social links come from Dex pair info.socials + Birdeye token_overview.
# Tweet volume requires a Twitter bearer and is off by default.
# Optional: comma-separated list of Solana mint addresses for top trader tracking.
# Required if INGEST_BIRDEYE_TOP_TRADERS=true. The top_traders endpoint is per-token.
BIRDEYE_TOP_TRADER_MINTS=

# --- Also read by code ---
OPENAI_API_URL=
LARGE_OPENAI_MODEL=
OPENAI_LARGE_MODEL=
RPC_URL=
